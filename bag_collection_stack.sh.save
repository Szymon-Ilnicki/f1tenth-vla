echo ""
echo "Both running. Bag manager should be at http://<phone-ip>:8000"
echo "Press Ctrl+C to stop everything."

# Wait and clean up on exit
trap "kill $LAUNCH_PID $BAG_PID 2>/dev/null; termux-wake-unlock 2>/dev/null; exit" INT TERM
wait
